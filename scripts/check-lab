#!/usr/bin/env bash

set -uo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root" || exit 1

readonly approved_debian="node:22-bookworm-slim@sha256:a17d50af28002a160548bd4225b3cfcb12c5efcb171f79e68758f2885fb1b066"
readonly approved_alpine="node:22-alpine@sha256:76789712cd1ae89a1225eac9077010d68987a423588042dac30446f502f1858c"

failures=0
temporary_directory=$(mktemp -d)
trap 'rm --recursive --force -- "$temporary_directory"' EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

for command in docker syft grype jq curl sha256sum; do
  if ! command -v "$command" >/dev/null 2>&1; then
    record_failure "$command is not available; reopen this repository in its devcontainer"
  fi
done

if ((failures > 0)); then
  printf '\nLab check stopped because required tools are unavailable.\n' >&2
  exit 1
fi

if ! sha256sum --check --quiet .lab-fixtures.sha256; then
  record_failure "an instructor-owned application or scanning fixture was changed"
fi

if ! syft version 2>&1 | grep --quiet --extended-regexp '(^|[^0-9])v?1\.50\.0([^0-9]|$)'; then
  record_failure "Syft 1.50.0 is required; rebuild the devcontainer"
fi

if ! grype version 2>&1 | grep --quiet --extended-regexp '(^|[^0-9])v?0\.116\.1([^0-9]|$)'; then
  record_failure "Grype 0.116.1 is required; rebuild the devcontainer"
fi

database_status=$(grype db status 2>&1 || true)
if ! grep --quiet 'Schema:[[:space:]]*v6\.1\.9' <<< "$database_status" ||
   ! grep --quiet 'Built:[[:space:]]*2026-08-13T06:39:30Z' <<< "$database_status" ||
   ! grep --quiet 'Status:[[:space:]]*valid' <<< "$database_status"; then
  record_failure "the frozen 2026-08-13 Grype database is not installed; rebuild the devcontainer"
fi

final_base=""
mapfile -t from_references < <(
  awk 'toupper($1) == "FROM" { print $2 }' Dockerfile 2>/dev/null
)

final_definition_valid=true
if ((${#from_references[@]} != 1)); then
  record_failure "Dockerfile must contain exactly one FROM instruction"
  final_definition_valid=false
else
  final_base=${from_references[0]}
  if [[ "$final_base" != "$approved_debian" && "$final_base" != "$approved_alpine" ]]; then
    record_failure "Dockerfile does not use one of the two approved digest-pinned bases"
    final_definition_valid=false
  fi
fi

if ! cmp --silent <(tail --lines=+2 Dockerfile.vulnerable) <(tail --lines=+2 Dockerfile); then
  record_failure "only the FROM reference may differ between Dockerfile.vulnerable and Dockerfile"
  final_definition_valid=false
fi

vulnerable_sbom="$temporary_directory/vulnerable-sbom.json"
vulnerable_scan="$temporary_directory/vulnerable-scan.json"
final_sbom="$temporary_directory/final-sbom.json"

printf '\nBuilding the instructor-owned vulnerable image...\n'
if ! docker build \
  --platform linux/amd64 \
  --file Dockerfile.vulnerable \
  --tag lab03:vulnerable \
  .; then
  record_failure "Dockerfile.vulnerable did not build"
elif ! ./scripts/smoke-test lab03:vulnerable; then
  record_failure "the vulnerable image did not pass its smoke test"
elif ! syft lab03:vulnerable --output syft-json > "$vulnerable_sbom"; then
  record_failure "Syft could not inventory the vulnerable image"
else
  grype lab03:vulnerable \
    --by-cve \
    --only-fixed \
    --fail-on critical \
    --output json > "$vulnerable_scan"
  vulnerable_status=$?

  if ((vulnerable_status != 2)); then
    record_failure "the vulnerable image did not fail the fixable-Critical policy with exit status 2"
  elif ! jq --exit-status '
    [.matches[] | select(
      .vulnerability.id == "CVE-2026-42010" and
      .vulnerability.severity == "Critical" and
      .artifact.name == "libgnutls30" and
      .artifact.type == "deb" and
      ((.vulnerability.fix.versions // []) | length > 0)
    )] | length > 0
  ' "$vulnerable_scan" >/dev/null; then
    record_failure "the frozen scan did not contain the expected fixable Critical Debian finding"
  fi
fi

if [[ "$final_definition_valid" == true ]]; then
  printf '\nBuilding the student final image...\n'
  if ! docker build \
    --platform linux/amd64 \
    --file Dockerfile \
    --tag lab03:final \
    .; then
    record_failure "Dockerfile did not build the final image"
  elif ! ./scripts/smoke-test lab03:final; then
    record_failure "the final image did not pass the same smoke test"
  elif ! syft lab03:final --output syft-json > "$final_sbom"; then
    record_failure "Syft could not inventory the final image"
  elif ! jq --exit-status '
    any(.artifacts[]; .name == "picocolors" and .type == "npm")
  ' "$final_sbom" >/dev/null; then
    record_failure "the final image no longer contains the supplied application dependency"
  else
    if ! grype lab03:final \
      --by-cve \
      --only-fixed \
      --fail-on critical \
      >/dev/null; then
      record_failure "the final image still has a fixable Critical finding"
    fi
  fi
fi

if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 3 checks passed.\n'
